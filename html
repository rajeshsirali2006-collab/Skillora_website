            <p class="text-base font-bold text-white">Rajesh S I &bull; Skillora</p>
            <p class="text-xs text-slate-400">B.E. Graduate (MS Engineering College, Bangalore) &bull; Data Analytics, Excel &amp; AI Workflows</p>
          </div>
        </div>

        <div class="flex flex-wrap gap-3 text-xs font-semibold">
          <a href="#about" class="px-3 py-1.5 rounded-lg bg-white/5 hover:bg-white/10 text-slate-200 transition">About</a>
          <a href="#services" class="px-3 py-1.5 rounded-lg bg-white/5 hover:bg-white/10 text-slate-200 transition">Services</a>
          <a href="#why-hire" class="px-3 py-1.5 rounded-lg bg-white/5 hover:bg-white/10 text-slate-200 transition">Why Hire Me</a>
          <a href="#work" class="px-3 py-1.5 rounded-lg bg-white/5 hover:bg-white/10 text-slate-200 transition">Credentials</a>
          <a href="#contact" class="px-3 py-1.5 rounded-lg bg-cyan-500/20 text-cyan-300 border border-cyan-400/30 hover:bg-cyan-500/30 transition">Contact / Quote</a>
        </div>
      </div>

      <div class="pt-6 border-t border-slate-800/80 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 text-xs text-slate-400">
        <p>&copy; 2026 Skillora &bull; Rajesh S I. Built strictly from verified resume and brand assets.</p>
        <p>Bangalore, Karnataka, India &bull; <a href="mailto:rajeshsirali21@gmail.com" class="text-cyan-300 hover:underline">rs6464497@gmail.com</a> &bull; +91 9380433994</p>
      </div>
    </div>
  </footer>

  <!-- Toast Notification for Copy Actions -->
  <div
    id="toast-banner"
    role="status"
    aria-live="polite"
    class="fixed bottom-5 right-5 z-50 hidden px-4 py-3 rounded-xl bg-slate-900 text-white text-xs sm:text-sm font-semibold shadow-xl border border-slate-700"
  >
    Copied to clipboard!
  </div>

  <script>
    (function () {
      // 1. Mobile Navigation Toggle
      const mobileMenuBtn = document.getElementById('mobile-menu-btn');
      const mobileMenu = document.getElementById('mobile-menu');
      const iconOpen = document.getElementById('menu-icon-open');
      const iconClose = document.getElementById('menu-icon-close');

      function setMobileMenu(open) {
        if (!mobileMenuBtn || !mobileMenu) return;
        mobileMenuBtn.setAttribute('aria-expanded', String(open));
        mobileMenu.classList.toggle('hidden', !open);
        iconOpen.classList.toggle('hidden', open);
        iconClose.classList.toggle('hidden', !open);
      }

      if (mobileMenuBtn) {
        mobileMenuBtn.addEventListener('click', function () {
          const isExpanded = mobileMenuBtn.getAttribute('aria-expanded') === 'true';
          setMobileMenu(!isExpanded);
        });
      }

      document.querySelectorAll('.mobile-nav-link').forEach(function (link) {
        link.addEventListener('click', function () {
          setMobileMenu(false);
        });
      });

      // 2. Top Utility Toggles: Highlight Placeholders & Reduced Motion
      const togglePlaceholdersBtn = document.getElementById('toggle-placeholders-btn');
      if (togglePlaceholdersBtn) {
        togglePlaceholdersBtn.addEventListener('click', function () {
          const active = document.body.classList.toggle('highlight-placeholders');
          togglePlaceholdersBtn.setAttribute('aria-pressed', String(active));
          togglePlaceholdersBtn.textContent = active
            ? 'Placeholders Highlighted (7)'
            : 'Highlight Placeholders (7)';
        });
      }

      const toggleMotionBtn = document.getElementById('toggle-motion-btn');
      if (toggleMotionBtn) {
        toggleMotionBtn.addEventListener('click', function () {
          const reduced = document.body.classList.toggle('force-reduced-motion');
          toggleMotionBtn.setAttribute('aria-pressed', String(reduced));
          toggleMotionBtn.textContent = reduced ? 'Motion: Reduced' : 'Motion: Standard';
          if (reduced) {
            document.querySelectorAll('.reveal-item').forEach(function (el) {
              el.classList.add('is-visible');
            });
          }
        });
      }

      // 3. Restrained Scroll Reveal Observer (Respecting prefers-reduced-motion)
      const prefersReducedMotion =
        window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const revealItems = document.querySelectorAll('.reveal-item');

      if (prefersReducedMotion || !('IntersectionObserver' in window)) {
        revealItems.forEach(function (el) {
          el.classList.add('is-visible');
        });
      } else {
        const observer = new IntersectionObserver(
          function (entries, obs) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                obs.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
        );
        revealItems.forEach(function (el) {
          observer.observe(el);
        });
      }

      // 4. Filterable Projects, Internship & Credentials
      const filterButtons = document.querySelectorAll('.work-filter-btn');
      const workCards = document.querySelectorAll('.work-card');

      filterButtons.forEach(function (btn) {
        btn.addEventListener('click', function () {
          const filter = btn.getAttribute('data-filter');
          filterButtons.forEach(function (b) {
            const isSelected = b === btn;
            b.setAttribute('aria-selected', String(isSelected));
            if (isSelected) {
              b.className =
                'work-filter-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold bg-skillora-navy text-white shadow-sm transition';
            } else {
              b.className =
                'work-filter-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold bg-white text-slate-700 border border-slate-200 hover:bg-slate-100 transition';
            }
          });

          workCards.forEach(function (card) {
            const cat = card.getAttribute('data-category');
            const show = filter === 'all' || cat === filter;
            card.classList.toggle('hidden', !show);
          });
        });
      });

      // 5. Inquiry Mode Switching ("Discuss a Project" vs "Request a Quote")
      const modeBtnProject = document.getElementById('mode-btn-project');
      const modeBtnQuote = document.getElementById('mode-btn-quote');
      const inquiryTypeInput = document.getElementById('inquiry-type-input');
      const submitInquiryBtn = document.getElementById('submit-inquiry-btn');
      const serviceSelect = document.getElementById('service-category');

      function setInquiryMode(mode) {
        const isQuote = mode === 'quote';
        if (inquiryTypeInput) {
          inquiryTypeInput.value = isQuote ? 'Request a Quote' : 'Discuss a Project';
        }
        if (modeBtnProject && modeBtnQuote) {
          modeBtnProject.setAttribute('aria-pressed', String(!isQuote));
          modeBtnQuote.setAttribute('aria-pressed', String(isQuote));
          modeBtnProject.className = !isQuote
            ? 'inquiry-mode-btn py-2.5 px-4 rounded-lg text-xs sm:text-sm font-bold bg-white text-slate-900 shadow-sm transition'
            : 'inquiry-mode-btn py-2.5 px-4 rounded-lg text-xs sm:text-sm font-bold text-slate-700 hover:text-slate-900 transition';
          modeBtnQuote.className = isQuote
            ? 'inquiry-mode-btn py-2.5 px-4 rounded-lg text-xs sm:text-sm font-bold bg-white text-slate-900 shadow-sm transition'
            : 'inquiry-mode-btn py-2.5 px-4 rounded-lg text-xs sm:text-sm font-bold text-slate-700 hover:text-slate-900 transition';
        }
        if (submitInquiryBtn) {
          submitInquiryBtn.textContent = isQuote
            ? 'Validate & Generate Quote Request (Demo State)'
            : 'Validate & Prepare Project Inquiry (Demo State)';
        }
      }

      if (modeBtnProject) {
        modeBtnProject.addEventListener('click', function () {
          setInquiryMode('project');
        });
      }
      if (modeBtnQuote) {
        modeBtnQuote.addEventListener('click', function () {
          setInquiryMode('quote');
        });
      }

      document.querySelectorAll('.cta-mode-trigger').forEach(function (el) {
        el.addEventListener('click', function () {
          const mode = el.getAttribute('data-inquiry-mode') || 'project';
          setInquiryMode(mode);
        });
      });

      document.querySelectorAll('.service-select-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
          const service = btn.getAttribute('data-service') || '';
          const mode = btn.getAttribute('data-mode') || 'quote';
          setInquiryMode(mode);
          if (serviceSelect && service) {
            serviceSelect.value = service;
          }
          const contactSection = document.getElementById('contact');
          if (contactSection) {
            contactSection.scrollIntoView({ behavior: 'smooth' });
          }
          const nameInput = document.getElementById('visitor-name');
          if (nameInput) {
            setTimeout(function () {
              nameInput.focus();
            }, 350);
          }
        });
      });

      // 6. Clipboard Helper & Toast
      const toastBanner = document.getElementById('toast-banner');
      let toastTimer = null;

      function showToast(msg) {
        if (!toastBanner) return;
        toastBanner.textContent = msg;
        toastBanner.classList.remove('hidden');
        if (toastTimer) clearTimeout(toastTimer);
        toastTimer = setTimeout(function () {
          toastBanner.classList.add('hidden');
        }, 2800);
      }

      function copyText(text, successMsg) {
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(text).then(
            function () {
              showToast(successMsg);
            },
            function () {
              fallbackCopy(text, successMsg);
            }
          );
        } else {
          fallbackCopy(text, successMsg);
        }
      }

      function fallbackCopy(text, successMsg) {
        const ta = document.createElement('textarea');
        ta.value = text;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        try {
          document.execCommand('copy');
          showToast(successMsg);
        } catch (err) {
          showToast('Copy ready');
        }
        document.body.removeChild(ta);
      }

      const copyEmailBtn = document.getElementById('copy-email-btn');
      if (copyEmailBtn) {
        copyEmailBtn.addEventListener('click', function () {
          copyText('rs6464497@gmail.com', 'Email rs6464497@gmail.com copied!');
        });
      }

      // 7. Accessible Form Validation & Non-Functional Demo State Submission
      const form = document.getElementById('project-inquiry-form');
      const errorSummary = document.getElementById('form-error-summary');
      const errorList = document.getElementById('form-error-list');
      const feedbackPanel = document.getElementById('submission-feedback');
      const briefPreview = document.getElementById('compiled-brief-preview');
      const mailtoLink = document.getElementById('mailto-launch-link');
      const copyBriefBtn = document.getElementById('copy-brief-btn');
      const resetFormBtn = document.getElementById('reset-form-btn');
      const fillSampleBtn = document.getElementById('fill-sample-btn');

      const requiredFields = [
        { id: 'visitor-name', errorId: 'visitor-name-error', label: 'Full Name is required.' },
        { id: 'visitor-email', errorId: 'visitor-email-error', label: 'A valid Email Address is required.', isEmail: true },
        { id: 'service-category', errorId: 'service-category-error', label: 'Please select a Service Category.' },
        { id: 'project-description', errorId: 'project-description-error', label: 'Please provide a brief Project Description.' },
        { id: 'project-goals', errorId: 'project-goals-error', label: 'Please list your Key Project Goals.' },
        { id: 'project-requirements', errorId: 'project-requirements-error', label: 'Please specify Technical Requirements & Tools.' },
        { id: 'project-budget', errorId: 'project-budget-error', label: 'Please select an Estimated Budget.' },
        { id: 'project-timeline', errorId: 'project-timeline-error', label: 'Please select a Target Timeline.' }
      ];

      function validateField(fieldCfg) {
        const input = document.getElementById(fieldCfg.id);
        const errEl = document.getElementById(fieldCfg.errorId);
        if (!input || !errEl) return null;
        const val = (input.value || '').trim();
        let errorMsg = '';

        if (!val) {
          errorMsg = fieldCfg.label;
        } else if (fieldCfg.isEmail && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(val)) {
          errorMsg = 'Please enter a valid email address (e.g., name@domain.com).';
        }

        if (errorMsg) {
          input.setAttribute('aria-invalid', 'true');
          input.classList.add('border-red-500');
          errEl.textContent = errorMsg;
          errEl.classList.remove('hidden');
          return errorMsg;
        } else {
          input.setAttribute('aria-invalid', 'false');
          input.classList.remove('border-red-500');
          errEl.textContent = '';
          errEl.classList.add('hidden');
          return null;
        }
      }

      requiredFields.forEach(function (cfg) {
        const el = document.getElementById(cfg.id);
        if (el) {
          el.addEventListener('input', function () {
            if (el.getAttribute('aria-invalid') === 'true') {
              validateField(cfg);
            }
          });
          el.addEventListener('change', function () {
            if (el.getAttribute('aria-invalid') === 'true') {
              validateField(cfg);
            }
          });
        }
      });

      if (fillSampleBtn) {
        fillSampleBtn.addEventListener('click', function () {
          document.getElementById('visitor-name').value = 'Ananya Rao';
          document.getElementById('visitor-email').value = 'ananya.rao@example-ops.in';
          document.getElementById('visitor-phone').value = '+91 98765 43210';
          document.getElementById('visitor-org').value = 'Apex Logistics Operations';
          document.getElementById('service-category').value = 'Advanced Excel Operations & Interactive Dashboards';
          document.getElementById('project-description').value =
            'We have 6 regional inventory spreadsheets with inconsistent columns and manual copy-paste formulas causing weekly reporting delays.';
          document.getElementById('project-goals').value =
            'Consolidate regional sheets using Power Query, reduce manual entry errors, and build a single KPI summary dashboard.';
          document.getElementById('project-requirements').value =
            'Microsoft Excel (Pivot Tables, VLOOKUP, Power Query) + automated validation checks.';
          document.getElementById('project-budget').value =
            '[Placeholder Tier 2] Standard Dashboard or Database Schema Project';
          document.getElementById('project-timeline').value = 'Short-Term (1–2 Weeks)';
          requiredFields.forEach(validateField);
          if (errorSummary) errorSummary.classList.add('hidden');
          showToast('Sample client brief populated!');
        });
      }

      if (form) {
        form.addEventListener('submit', function (e) {
          e.preventDefault();
          const errors = [];
          requiredFields.forEach(function (cfg) {
            const err = validateField(cfg);
            if (err) errors.push(err);
          });

          if (errors.length > 0) {
            if (errorList && errorSummary) {
              errorList.innerHTML = '';
              errors.forEach(function (msg) {
                const li = document.createElement('li');
                li.textContent = msg;
                errorList.appendChild(li);
              });
              errorSummary.classList.remove('hidden');
              errorSummary.focus();
            }
            if (feedbackPanel) feedbackPanel.classList.add('hidden');
            return;
          }

          if (errorSummary) errorSummary.classList.add('hidden');

          const inquiryType = document.getElementById('inquiry-type-input').value;
          const name = document.getElementById('visitor-name').value.trim();
          const email = document.getElementById('visitor-email').value.trim();
          const phone = document.getElementById('visitor-phone').value.trim() || 'Not provided';
          const org = document.getElementById('visitor-org').value.trim() || 'Not provided';
          const service = document.getElementById('service-category').value;
          const desc = document.getElementById('project-description').value.trim();
          const goals = document.getElementById('project-goals').value.trim();
          const reqs = document.getElementById('project-requirements').value.trim();
          const budget = document.getElementById('project-budget').value;
          const timeline = document.getElementById('project-timeline').value;

          const briefText = [
            '=== SKILLORA FREELANCE INQUIRY (' + inquiryType.toUpperCase() + ') ===',
            'To: Rajesh S I (rajeshsirali21@gmail.com)',
            'From: ' + name + ' (' + email + ')',
            'Additional Contact: ' + phone,
            'Organization: ' + org,
            'Service Category: ' + service,
            'Estimated Budget: ' + budget,
            'Target Timeline: ' + timeline,
            '',
            '--- Project Description ---',
            desc,
            '',
            '--- Project Goals ---',
            goals,
            '',
            '--- Technical Requirements & Tools ---',
            reqs
          ].join('\n');

          if (briefPreview) {
            briefPreview.textContent = briefText;
          }
          if (mailtoLink) {
            const subject = encodeURIComponent('[Skillora ' + inquiryType + '] ' + service + ' — ' + name);
            const body = encodeURIComponent(briefText);
            mailtoLink.setAttribute('href', 'mailto:rajeshsirali21@gmail.com?subject=' + subject + '&body=' + body);
          }
          if (feedbackPanel) {
            feedbackPanel.classList.remove('hidden');
            feedbackPanel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          }
        });
      }

      if (copyBriefBtn) {
        copyBriefBtn.addEventListener('click', function () {
          const text = briefPreview ? briefPreview.textContent : '';
          if (text) {
            copyText(text, 'Formatted project brief copied to clipboard!');
          }
        });
      }

      if (resetFormBtn && form) {
        resetFormBtn.addEventListener('click', function () {
          form.reset();
          if (feedbackPanel) feedbackPanel.classList.add('hidden');
          if (errorSummary) errorSummary.classList.add('hidden');
          document.getElementById('visitor-name').focus();
        });
      }
    })();
  </script>
